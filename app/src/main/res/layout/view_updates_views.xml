<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<FrameLayout
		android:id="@+id/container_map"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_marginTop="@dimen/history_views_bar_height"
		android:visibility="gone" />

	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="@dimen/history_views_bar_height"
		android:background="?attr/colorSurface"
		android:clipToPadding="false"
		android:paddingHorizontal="16dp"
		android:scrollbars="none">

		<com.google.android.material.chip.ChipGroup
			android:id="@+id/chipGroup_modes"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			app:selectionRequired="true"
			app:singleLine="true"
			app:singleSelection="true">

			<com.google.android.material.chip.Chip android:id="@+id/chip_mode_map" style="@style/Widget.Futon.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/updates_view_map" />
			<com.google.android.material.chip.Chip android:id="@+id/chip_mode_list" style="@style/Widget.Futon.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/updates_view_list" />

		</com.google.android.material.chip.ChipGroup>

	</HorizontalScrollView>

</FrameLayout>
