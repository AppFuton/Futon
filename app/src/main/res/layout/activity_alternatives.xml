<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/appbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:fitsSystemWindows="false">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			app:subtitleCentered="true"
			app:titleCentered="true"
			tools:title="@string/replace_source" />

		<com.google.android.material.progressindicator.LinearProgressIndicator
			android:id="@+id/progressSources"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:indeterminate="true"
			android:visibility="gone"
			app:hideAnimationBehavior="escape"
			app:showAnimationBehavior="inward" />

		<HorizontalScrollView
			android:id="@+id/scrollViewSummary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clipToPadding="false"
			android:paddingHorizontal="12dp"
			android:scrollbars="none">

			<io.github.landwarderer.futon.core.ui.widgets.ChipsView
				android:id="@+id/chipsSummary"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingVertical="4dp"
				app:chipStyle="@style/Widget.Futon.Chip.Filter"
				app:singleLine="true"
				tools:ignore="SpeakableTextPresentCheck" />

		</HorizontalScrollView>

		<LinearLayout
			android:id="@+id/planningProgressContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:paddingStart="24dp"
			android:paddingEnd="24dp"
			android:paddingBottom="16dp"
			android:visibility="gone"
			tools:visibility="visible">

			<TextView
				android:id="@+id/textViewPlanningStep"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:textAlignment="center"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?android:textColorPrimary"
				tools:text="Step 1 of 2 · Comparing 12 titles" />

			<com.google.android.material.progressindicator.LinearProgressIndicator
				android:id="@+id/planningProgressBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:indeterminate="true" />

			<TextView
				android:id="@+id/textViewPlanningRemaining"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:gravity="center"
				android:textAlignment="center"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:textColor="?android:textColorSecondary"
				tools:text="6 sources · 58 checks left" />

		</LinearLayout>

	</com.google.android.material.appbar.AppBarLayout>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recyclerView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:orientation="vertical"
		android:padding="@dimen/list_spacing_normal"
		android:scrollbars="vertical"
		app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
		app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
		tools:listitem="@layout/item_manga_alternative" />

	<ScrollView
		android:id="@+id/summaryContainer"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:visibility="gone"
		app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
		tools:visibility="visible">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:orientation="vertical"
			android:padding="20dp">

			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:maxWidth="560dp"
				app:cardBackgroundColor="?colorSurfaceContainerLow"
				app:cardCornerRadius="28dp"
				app:cardElevation="0dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:orientation="vertical"
					android:padding="24dp">

					<com.google.android.material.card.MaterialCardView
						android:layout_width="80dp"
						android:layout_height="80dp"
						app:cardBackgroundColor="?colorTertiaryContainer"
						app:cardElevation="0dp"
						app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Futon.Circle">

						<ImageView
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:layout_gravity="center"
							android:contentDescription="@null"
							android:src="@drawable/ic_check"
							app:tint="?colorOnTertiaryContainer" />

					</com.google.android.material.card.MaterialCardView>

					<TextView
						android:id="@+id/textViewSummaryTitle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="20dp"
						android:gravity="center"
						android:textAlignment="center"
						android:textAppearance="?attr/textAppearanceHeadlineSmall"
						android:textColor="?android:textColorPrimary"
						tools:text="Replacement complete" />

					<TextView
						android:id="@+id/textViewSummaryMessage"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:gravity="center"
						android:textAlignment="center"
						android:textAppearance="?attr/textAppearanceBodyLarge"
						android:textColor="?android:textColorSecondary"
						tools:text="12 titles were moved to working sources." />

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="24dp"
						android:baselineAligned="false"
						android:orientation="horizontal">

						<com.google.android.material.card.MaterialCardView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginEnd="6dp"
							android:layout_weight="1"
							app:cardBackgroundColor="?colorPrimaryContainer"
							app:cardCornerRadius="20dp"
							app:cardElevation="0dp">

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center"
								android:orientation="vertical"
								android:padding="16dp">

								<TextView
									android:id="@+id/textViewSummaryReplaced"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:textAppearance="?attr/textAppearanceHeadlineMedium"
									android:textColor="?colorOnPrimaryContainer"
									tools:text="12" />

								<TextView
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center"
									android:text="@string/source_replacement_summary_replaced"
									android:textAppearance="?attr/textAppearanceLabelMedium"
									android:textColor="?colorOnPrimaryContainer" />

							</LinearLayout>

						</com.google.android.material.card.MaterialCardView>

						<com.google.android.material.card.MaterialCardView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginStart="6dp"
							android:layout_weight="1"
							app:cardBackgroundColor="?colorSecondaryContainer"
							app:cardCornerRadius="20dp"
							app:cardElevation="0dp">

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center"
								android:orientation="vertical"
								android:padding="16dp">

								<TextView
									android:id="@+id/textViewSummarySources"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:textAppearance="?attr/textAppearanceHeadlineMedium"
									android:textColor="?colorOnSecondaryContainer"
									tools:text="3" />

								<TextView
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center"
									android:text="@string/source_replacement_summary_sources"
									android:textAppearance="?attr/textAppearanceLabelMedium"
									android:textColor="?colorOnSecondaryContainer" />

							</LinearLayout>

						</com.google.android.material.card.MaterialCardView>

					</LinearLayout>

					<LinearLayout
						android:id="@+id/summaryMixContainer"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="24dp"
						android:gravity="center"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/source_replacement_summary_mix"
							android:textAppearance="?attr/textAppearanceLabelLarge"
							android:textColor="?android:textColorSecondary" />

						<TextView
							android:id="@+id/textViewSummaryMix"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:gravity="center"
							android:textAlignment="center"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:textColor="?android:textColorPrimary"
							tools:text="MangaDex · 8 • Comick · 4" />

					</LinearLayout>

					<com.google.android.material.button.MaterialButton
						android:id="@+id/buttonSummaryDone"
						style="@style/Widget.Material3.Button"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="28dp"
						android:text="@string/done" />

				</LinearLayout>

			</com.google.android.material.card.MaterialCardView>

		</LinearLayout>

	</ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
